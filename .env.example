# Port the API listens on. Render sets PORT for you in production.
PORT=5000

# development | test | production
NODE_ENV=development

# MongoDB connection string. Leave this empty to run without a database.
# Local:  mongodb://127.0.0.1:27017/hcm-lite
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/hcm-lite
MONGODB_URI=

# Signs the login cookie. At least 16 characters. Use a long random value on Render.
JWT_SECRET=replace-with-a-long-random-string

# Frontend origin allowed to call this API with cookies (scheme + host + port).
# On Render set this to the Vercel app, for example https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# AI chat. Leave the key empty and the API still boots. Chat then returns a friendly message.
# The browser must never see this key.
AI_API_KEY=
# OpenAI-compatible chat completions. A missing trailing slash is added for you.
# Any compatible host works: set AI_BASE_URL and AI_MODEL. Defaults are Gemini.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.5-flash
# About 20 requests per user per hour. Whole number from 1 to 1000.
# AI_RATE_LIMIT=20
# Milliseconds before the assistant call is aborted. Whole number from 1000 to 60000.
# AI_TIMEOUT_MS=15000

# Camera face match. 0 to 1. Same scale as @vladmandic/human match.similarity.
# A camera check-in is refused when the live face scores below this. Default 0.55.
# FACE_MATCH_THRESHOLD=0.55

# Optional first-run bootstrap. Leave all three empty so a judge can use the setup screen.
# If you set the email and password, the server creates the admin on boot (once).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# COMPANY_NAME=Saylani
