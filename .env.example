# Port the API listens on. Render sets PORT for you in production.
PORT=5000

# development | test | production
NODE_ENV=development

# MongoDB connection string. Leave this empty to run without a database.
# Local:  mongodb://127.0.0.1:27017/hackathon
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/hackathon
MONGODB_URI=

# Frontend origin allowed to call this API with cookies (scheme + host + port).
CLIENT_URL=http://localhost:5173
